---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Hero from '../components/Hero.astro';
import Migas from '../components/Migas.astro';
import QueEs from '../components/QueEs.astro';
import Capitulos from '../components/Capitulos.astro';
import Programa from '../components/Programa.astro';
import Ponentes from '../components/Ponentes.astro';
import Sede from '../components/Sede.astro';
import Hospedaje from '../components/Hospedaje.astro';
import Inscripcion from '../components/Inscripcion.astro';
import Auspiciantes from '../components/Auspiciantes.astro';
import PieDePagina from '../components/PieDePagina.astro';
---

<Base>
  <Encabezado />
  <main id="contenido">
    <Hero />
    <Migas />
    <QueEs />
    <Capitulos />
    <Programa />
    <Ponentes />
    <Sede />
    <Hospedaje />
    <Inscripcion />
    <Auspiciantes />
  </main>
  <PieDePagina />
</Base>

---
const capitulos = [
  {
    src: '/img/capitulo-pes.png',
    alt: 'IEEE PES Ecuador Chapter',
    nivel: 'Strategic Partner',
    tier: 'strategic',
  },
  {
    src: '/img/capitulo-cas-eds.png',
    alt: 'IEEE CAS & EDS Ecuador Joint Chapter',
    nivel: 'Impact Partner',
    tier: 'impact',
  },
  {
    src: '/img/capitulo-css-ies.png',
    alt: 'IEEE CSS & IES Ecuador Joint Chapter',
    nivel: 'Impact Partner',
    tier: 'impact',
  },
  {
    src: '/img/capitulo-ras.png',
    alt: 'IEEE RAS Ecuador Chapter',
    nivel: 'Supporting Partner',
    tier: 'supporting',
  },
];
---

<section id="capitulos" class="seccion seccion--gris">
  <div class="contenedor">
    <h2 class="titulo-seccion" data-anim>Capítulos que apoyan esta edición</h2>
    <div class="regla" data-anim></div>

    <div class="niveles">
      {
        capitulos.map((c, i) => (
          <div
            class:list={['celda', `celda--${c.tier}`]}
            data-anim
            data-anim-delay={String(Math.min(i + 1, 4))}
          >
            <img src={c.src} alt={c.alt} loading="lazy" decoding="async" />
            <span class="celda__nivel">{c.nivel}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .niveles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 700px) {
    .niveles {
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(16px, 2vw, 22px);
    }
  }

  .celda {
    background: var(--blanco);
    border: 1px solid var(--linea);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
  }

  .celda img {
    display: block;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  .celda__nivel {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-3);
  }

  /* Nivel 1 — Strategic Partner: el mayor aporte, la tarjeta más visible */
  .celda--strategic {
    border-top: 6px solid var(--azul-700);
    box-shadow: 0 12px 30px rgba(0, 98, 155, 0.18);
    height: 190px;
  }

  .celda--strategic img {
    max-height: 96px;
  }

  .celda--strategic .celda__nivel {
    font-size: 12px;
    color: var(--azul-700);
  }

  @media (min-width: 700px) {
    .celda--strategic {
      grid-column: 1 / -1;
      height: 220px;
    }

    .celda--strategic img {
      max-height: 140px;
    }
  }

  /* Nivel 2 — Impact Partner */
  .celda--impact {
    border-top: 4px solid var(--azul-700);
    box-shadow: 0 6px 18px rgba(0, 98, 155, 0.1);
    height: 150px;
  }

  .celda--impact img {
    max-height: 78px;
  }

  .celda--impact .celda__nivel {
    color: var(--azul-700);
  }

  @media (min-width: 700px) {
    .celda--impact {
      grid-column: span 2;
      height: 160px;
    }

    .celda--impact img {
      max-height: 96px;
    }
  }

  /* Nivel 3 — Supporting Partner: presente, pero un escalón por debajo */
  .celda--supporting {
    border-top: 3px solid var(--linea);
    box-shadow: none;
    height: 120px;
    opacity: 0.92;
  }

  .celda--supporting img {
    max-height: 60px;
  }

  @media (min-width: 700px) {
    .celda--supporting {
      grid-column: 2 / span 2;
      height: 130px;
      max-width: 70%;
      margin: 0 auto;
    }

    .celda--supporting img {
      max-height: 70px;
    }
  }
</style>

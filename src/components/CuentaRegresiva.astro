---
interface Props {
  revelaEn: string;
}
const { revelaEn } = Astro.props;

const unidades = [
  { clave: 'dias', etiqueta: 'días' },
  { clave: 'horas', etiqueta: 'horas' },
  { clave: 'minutos', etiqueta: 'min' },
  { clave: 'segundos', etiqueta: 'seg' },
];
---

<div class="cortina" data-cortina data-revela-en={revelaEn} role="status" aria-live="polite">
  <div class="tarjeta">
    <p class="tarjeta__kicker">Programa preliminar</p>
    <p class="tarjeta__texto">El detalle de horarios se publica el</p>
    <p class="tarjeta__fecha">miércoles 23 de septiembre · 12h00</p>

    <div class="reloj">
      {
        unidades.map((u) => (
          <div class="reloj__casilla">
            <span class="reloj__numero" data-unidad={u.clave}>--</span>
            <span class="reloj__etiqueta">{u.etiqueta}</span>
          </div>
        ))
      }
    </div>

    <p class="tarjeta__pie">Se revela solo, sin recargar la página.</p>
  </div>
</div>

<style>
  .cortina {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(20px, 8vw, 48px) 16px;
    background: rgba(246, 247, 248, 0.5);
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    transition:
      opacity 600ms ease,
      backdrop-filter 600ms ease;
  }

  @media (min-width: 900px) {
    .cortina {
      align-items: center;
      padding-block: 24px;
    }
  }

  /* Navegadores sin backdrop-filter: velo sólido para que nada se transparente. */
  @supports not ((backdrop-filter: blur(4px)) or (-webkit-backdrop-filter: blur(4px))) {
    .cortina {
      background: rgba(246, 247, 248, 0.97);
    }
  }

  .cortina--fuera {
    opacity: 0;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    pointer-events: none;
  }

  .tarjeta {
    position: sticky;
    top: calc(var(--alto-cabecera) + 16px);
    background: var(--blanco);
    border-top: 4px solid var(--azul-700);
    box-shadow: 0 6px 24px rgba(0, 40, 85, 0.18);
    padding: 20px 20px 22px;
    max-width: 420px;
    width: 100%;
    text-align: center;
  }

  .tarjeta__kicker {
    margin: 0 0 6px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--azul-700);
  }

  .tarjeta__texto {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--tinta);
  }

  .tarjeta__fecha {
    margin: 2px 0 16px;
    font-size: 16px;
    font-weight: 700;
    color: var(--azul-900);
  }

  .reloj {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--linea);
    border: 1px solid var(--linea);
  }

  .reloj__casilla {
    background: var(--gris);
    padding: 10px 4px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .reloj__numero {
    font-size: clamp(20px, 6vw, 28px);
    font-weight: 700;
    color: var(--azul-700);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .reloj__etiqueta {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-3);
  }

  .tarjeta__pie {
    margin: 14px 0 0;
    font-size: 12.5px;
    color: var(--tinta-3);
  }
</style>
